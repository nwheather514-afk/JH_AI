# No secrets are needed. Supabase is reached from the browser with a publishable key (src/supabase-config.json).
# Optional: set these in your shell or in Vercel > Project > Settings > Environment Variables.

# Shown in the landing page footer
COMPANY_NAME=
CONTACT_EMAIL=
CONTACT_PHONE=

# Optional overrides for the public Supabase settings
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
